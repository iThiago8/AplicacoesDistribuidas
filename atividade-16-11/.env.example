# Configuração local opcional. Sem .env, os padrões didáticos funcionam.
API_URL=http://127.0.0.1:8000
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=admin123
# Antes de expor o serviço, configure uma chave aleatória de pelo menos 32 bytes.
# Gerar: python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=cole_a_chave_gerada_aqui
SEED_DEMO=1
